<?xml version="1.0" encoding="utf-8"?>
<!-- UNKNOWN state of a pill: the aircraft has not said whether the thing is on or off.
     Specification §4.6 — unknown is its OWN state and is never collapsed into "off". Same
     geometry as bg_zoom_pill and bg_ar_pill_active so a control never changes size as its state
     changes; only the colour moves. Amber #FFB74D, the app's tp_state_unknown. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp" />
    <solid android:color="#4DFFB74D" />
    <stroke android:width="1.5dp" android:color="#FFFFB74D" />
</shape>
